generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -- 用户（网络模式专用，单机模式有哨兵行 id=0）--
model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String
  displayName  String
  role         String       @default("parent") // parent | child
  createdAt    String
  updatedAt    String
  tasks        Task[]
  checkins     CheckIn[]
  redemptions  Redemption[]
  products     Product[]
  exerciseTypes ExerciseType[]
  exercises    Exercise[]
  settings     Setting[]
  schedules    ScheduleEntry[]
  scheduleAttendances ScheduleAttendance[]
}

// -- 任务 --
model Task {
  id            Int        @id @default(autoincrement())
  name          String
  subject       String
  emoji         String     @default("📚")
  estimatedMin  Int        @default(0)
  deadlineTime  String?
  startDate     String?
  repeatType    String     @default("once") // once | daily | weekly
  repeatDays    String     @default("[]")   // JSON array [1,3,5]
  sortOrder     Int        @default(0)
  isActive      Int        @default(1)
  points        Int        @default(3)
  createdAt     String
  updatedAt     String
  userId        Int        @default(0)
  user          User?      @relation(fields: [userId], references: [id])
  checkins      CheckIn[]
}

// -- 打卡记录 --
model CheckIn {
  id           Int     @id @default(autoincrement())
  taskId       Int
  task         Task    @relation(fields: [taskId], references: [id])
  date         String
  completedAt  String
  quality      Int?
  photoUrl     String?
  note         String?
  isMakeup     Int     @default(0)
  userId       Int     @default(0)
  user         User?   @relation(fields: [userId], references: [id])

  @@unique([taskId, date])
}

// -- 积分兑换 --
model Redemption {
  id          Int      @id @default(autoincrement())
  name        String
  points      Int
  date        String
  photoUrl    String?
  createdAt   String
  productId   Int?
  status      String   @default("pending")
  appliedAt   String?
  approvedAt  String?
  userId      Int      @default(0)
  user        User?    @relation(fields: [userId], references: [id])
}

// -- 兑换商品 --
model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  points      Int
  photoUrl    String?
  isActive    Int     @default(1)
  sortOrder   Int     @default(0)
  createdAt   String
  userId      Int     @default(0)
  user        User?   @relation(fields: [userId], references: [id])
}

// -- 运动类型 --
model ExerciseType {
  id          Int         @id @default(autoincrement())
  name        String
  emoji       String      @default("🏃")
  unit        String      @default("次")
  isPreset    Int         @default(1)
  isActive    Int         @default(1)
  sortOrder   Int         @default(0)
  createdAt   String
  userId      Int         @default(0)
  user        User?       @relation(fields: [userId], references: [id])
  exercises   Exercise[]
}

// -- 运动记录 --
model Exercise {
  id              Int          @id @default(autoincrement())
  exerciseTypeId  Int
  exerciseType    ExerciseType @relation(fields: [exerciseTypeId], references: [id])
  date            String
  completedAt     String
  quality         Int?
  sets            String?
  note            String?
  isMakeup        Int          @default(0)
  createdAt       String
  userId          Int          @default(0)
  user            User?        @relation(fields: [userId], references: [id])
}

// -- 设置 --
model Setting {
  key    String @id
  value  String
  userId Int    @default(0)
  user   User?  @relation(fields: [userId], references: [id])
}

// -- 课程表 --
model ScheduleEntry {
  id             Int    @id @default(autoincrement())
  name           String
  type           String      @default("course")
  emoji          String      @default("📖")
  repeatType     String      @default("weekly")
  repeatDays     String      @default("[]")
  date           String?
  startTime      String
  endTime        String
  location       String?
  appName        String?   // 远程课的上课 App（如"腾讯会议/钉钉课堂"）
  remindDayBefore Int        @default(1)
  remindMinBefore Int        @default(30)
  isActive       Int         @default(1)
  createdAt      String
  updatedAt      String
  userId         Int         @default(0)
  user           User?       @relation(fields: [userId], references: [id])
  attendances    ScheduleAttendance[]
}

// -- 课程出勤记录 --
model ScheduleAttendance {
  id          Int       @id @default(autoincrement())
  scheduleId  Int
  schedule    ScheduleEntry @relation(fields: [scheduleId], references: [id])
  date        String
  status      String    @default("attended")
  note        String?
  createdAt   String
  updatedAt   String
  userId      Int       @default(0)
  user        User?     @relation(fields: [userId], references: [id])

  @@unique([scheduleId, date])
}
